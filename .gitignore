/target
.DS_Store
*.log

# --- environment / secrets (ores-sops + age) -------------------------------
# Plaintext dotenv is local-only at every depth.
*.env
*/*.env
*/**/*.env
.env.*
*.env.*
!.env.example

# Decrypted material is runtime-only.
/env/dec/

# Deny all encrypted environment names, then permit only the reviewed contract.
/env/enc/*
!/env/enc/dev.env.enc
!/env/enc/prod.env.enc

# age private keys — never commit these.
*.agekey
*.age-key
keys.txt
sops-private*.txt

# Built Astro site. NOT committed — deployment builds it and supplies STATIC_DIR.
/static
/dist

# Browser E2E deps (playwright/puppeteer/@fiducia/test-config)
node_modules/
package-lock.json

# Zed package dependencies
/.vendor/.zed/

# Scratch / git worktrees
tmp/
temp/

# --- hardened baseline ------------------------------------------------------
Thumbs.db
*.swp
*~
.direnv/
target/
**/*.rs.bk
*.pdb
.cargo-target-*/
